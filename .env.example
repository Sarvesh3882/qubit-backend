# ── QUBIT Backend — Environment Variables ─────────────────────────────────────
#
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# Keys marked REQUIRED must be set before starting the server.
# Keys marked OPTIONAL improve functionality but are not required to run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────

# [REQUIRED] Secret key used to sign JWTs. Must be at least 32 random chars.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-string

# JWT signing algorithm. RS256 for production, HS256 for dev.
ALGORITHM=HS256

# Access token lifetime in minutes. Default 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────

# [REQUIRED] SQLAlchemy async connection string.
# SQLite (dev):      sqlite+aiosqlite:///./qubit.db
# PostgreSQL (prod): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./qubit.db

# ── CORS ──────────────────────────────────────────────────────────────────────

# [REQUIRED] Frontend origin allowed by CORS. No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# ── Origin Quantum / QPanda3 Runtime ─────────────────────────────────────────

# [OPTIONAL] API key for QPanda3 Runtime SDK (Origin Quantum Wukong QPUs).
# Required only to submit jobs to real quantum hardware.
# Leave blank to use local Qiskit Aer simulation.
# Obtain a key at: https://qcloud.originqc.com
QPANDA3_API_KEY=

# [OPTIONAL] QPanda3 Runtime server URL. Default is the official Origin Quantum endpoint.
# Only set this if instructed to point at a different server.
# QPANDA3_SERVER_URL=https://qpanda3-runtime.qpanda.cn

# [OPTIONAL] QPanda3 channel. "qcloud" is the only documented public channel.
# QPANDA3_CHANNEL=qcloud

# [OPTIONAL] Path to a qpanda3 config.yml file (alternative auth method).
# QPANDA3_CONFIG_PATH=./qpanda3_config.yml

# ── Research Intelligence ─────────────────────────────────────────────────────

# [OPTIONAL] GNews API key — required for the news feed feature.
# Without this key the /api/news/* endpoints return empty results.
# Get a free key (100 req/day) at: https://gnews.io
GNEWS_API_KEY=

# [OPTIONAL] OpenAlex polite-pool email.
# Strongly recommended — moves your requests to the "polite" pool with
# higher rate limits and priority. No account needed; just provide an email.
# Docs: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=

# [OPTIONAL] Semantic Scholar API key.
# Works without a key (unauthenticated free tier: 100 req / 5 min).
# Add a key to get 1 req/s and higher daily quotas.
# Get a free key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# [OPTIONAL] In-process research cache TTL in seconds. Default 1800 (30 minutes).
# RESEARCH_CACHE_TTL_SECONDS=1800
